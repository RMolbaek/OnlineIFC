{
  "name": "Vispecta – IFC viewer for infrastructure",
  "short_name": "Vispecta",
  "description": "IFC viewer for rail and road projects: alignments and stationing, cross sections, longitudinal profiles and drawings, IDS checks and BCF. Free and open source; your files never leave your computer.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "lang": "en",
  "categories": ["productivity", "utilities"],
  "background_color": "#EEF5F4",
  "theme_color": "#0C2A30",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-step": [".ifc"],
        "application/octet-stream": [".ifc"],
        "application/json": [".vispecta.json", ".onlineifc.json"]
      }
    }
  ]
}
